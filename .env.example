# panta-truth-cards — copy to .env. Never commit .env.
# Panta Public API key (https://docs.panta.market). Sent as X-Api-Key.
PANTA_API_KEY=
PANTA_BASE_URL=https://live-api.panta.market/api/v1
# Optional: link template for each card, {id} is replaced with the market id. Empty = no link.
PANTA_MARKET_URL=
